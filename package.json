{
  "name": "vistoria",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:init": "pnpm --filter db-init start",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "prod:init": "node scripts/db-init/prod-env.mjs",
    "prod:up": "docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d --build --wait",
    "prod:down": "docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod down",
    "dev:api": "pnpm --filter dev-api start",
    "dev:web": "pnpm --filter web dev",
    "seed": "pnpm --filter seed start",
    "gen:api": "pnpm --filter gen-api generate",
    "check": "pnpm --filter web check && pnpm --filter screens test && pnpm --filter db-init test && pnpm --filter dev-api test && pnpm --filter seed test && pnpm --filter outbox-spike test && pnpm --filter layout-tables test",
    "test:api": "cd apps/api && dotnet test --solution Vistoria.sln",
    "screens": "pnpm --filter screens start",
    "spike:outbox": "pnpm --filter outbox-spike start",
    "spike:conflict": "pnpm --filter conflict-spike start",
    "spike:shell": "pnpm --filter shell-spike start",
    "spike:device": "pnpm --filter device-spike start",
    "spike:volume": "pnpm --filter volume-spike start",
    "spike:migration": "pnpm --filter volume-spike migration",
    "layout:tables": "pnpm --filter layout-tables start",
    "smoke:prod": "pnpm --filter prod-smoke start"
  }
}
