{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(dotnet:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Read(infra/.env)",
      "Edit(infra/.env)",
      "Bash(cat infra/.env)"
    ]
  }
}
