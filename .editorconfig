root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.sln]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Testes nomeados como Metodo_Cenario: o sublinhado é a convenção, não um erro.
[apps/api/Vistoria.Api.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# Saída do `dotnet ef migrations add`: os analisadores não opinam em código gerado (CA1861 nos índices compostos).
[apps/api/Vistoria.Api/Migrations/**.cs]
generated_code = true
