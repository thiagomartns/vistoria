{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:api": "pnpm --filter gen-api generate"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "@sanjou/tokens": "0.2.0",
    "@sanjou/ui": "0.2.0",
    "@tanstack/db": "1.0.0-rc.1.1",
    "@tanstack/offline-transactions": "1.2.0",
    "@tanstack/react-db": "1.0.0-rc.1.1",
    "lucide-react": "1.66.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "serwist": "9.5.13",
    "sonner": "2.0.8",
    "uuid": "14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serwist/cli": "9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
