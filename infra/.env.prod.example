# Variáveis do infra/docker-compose.prod.yml. Este arquivo só lista os nomes: NUNCA coloque um valor aqui (ADR 0025).
#
# O infra/.env.prod (ignorado pelo git) é gerado com valores aleatórios por:
#   pnpm prod:init
MSSQL_SA_PASSWORD=
JWT_SIGNING_KEY=

# Opcionais, sem segredo: o domínio do Caddy (padrão: localhost, com a CA interna dele) e a interface das portas 80 e
# 443 (padrão: 127.0.0.1, só esta máquina; 0.0.0.0 abre para a rede, decisão da hospedagem).
SITE_ADDRESS=
PROXY_BIND=
