# Variáveis do infra/docker-compose.dev.yml. Este arquivo só lista os nomes: NUNCA coloque um valor aqui.
# Uma senha de exemplo commitada é uma senha pública, e quem copia o arquivo passa a usá-la (ADR 0025).
#
# O infra/.env (ignorado pelo git) é gerado com uma senha aleatória, já gravada nos User Secrets da API:
#   pnpm db:init
# Para trocar a senha depois, com o banco rodando e sem perder dados: pnpm db:init --rotate
MSSQL_SA_PASSWORD=

# Senha do usuário de dev (dev@vistoria.local), gerada aqui pelo pnpm seed na primeira vez. Os roteiros que entram
# como esse usuário a leem deste arquivo.
DEV_USER_PASSWORD=
